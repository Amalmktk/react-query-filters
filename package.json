{
  "name": "react-query-filters",
  "version": "1.0.0",
  "description": "Headless React hook for search, filters, sorting, and pagination that stay synchronized with the URL.",
  "keywords": [
    "react",
    "hooks",
    "url",
    "query-params",
    "filters",
    "search",
    "pagination",
    "sorting",
    "nextjs"
  ],
  "author": "Amal M",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amalmktk/react-query-filters.git"
  },
  "bugs": {
    "url": "https://github.com/Amalmktk/react-query-filters/issues"
  },
  "homepage": "https://github.com/Amalmktk/react-query-filters#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
